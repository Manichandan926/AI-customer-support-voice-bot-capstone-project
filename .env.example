# Copy this file to .env and fill in any keys you have. All are optional:
# with no keys the bot runs as a pure rule engine. Providers are tried in
# the order groq -> gemini -> claude (see AI_PROVIDER_ORDER in config.py).

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid, per use: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-opus-5

# Speech recognition locale (en-IN, en-US, en-GB, ...)
# ASR_LANGUAGE=en-IN

# Aria's voice: neural (online) with offline fallback
# TTS_VOICE=en-IN-NeerjaNeural
# TTS_ENGINE=edge          # set to sapi to force the offline Windows voice
